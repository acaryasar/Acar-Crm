# Copy this file to .env and fill in real values. Never commit .env.

DATABASE_URL="file:./dev.db"

# Production database (Turso). Leave both unset for local dev — the
# app then falls back to the local prisma/dev.db sqlite file.
# TURSO_DATABASE_URL="libsql://<your-db>-<org>.turso.io"
# TURSO_AUTH_TOKEN="<token from `turso db tokens create <your-db>`>"
AUTH_SECRET="generate-a-random-32-byte-secret"
AUTH_URL="http://localhost:3004"

# --> Mock (default, no external API calls)
AI_PROVIDER=mock
# --< Mock

# --> OpenAI
#AI_PROVIDER=openai
#OPENAI_API_KEY="your-openai-api-key-here"
# --< OpenAI

# --> Ollama (local LLM)
#AI_PROVIDER=ollama
#OLLAMA_BASE_URL="http://localhost:11434/v1"
#OLLAMA_MODEL="llama3"
# --< Ollama

# Mail sync (IMAP)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
MOCK_MODE=true

# WhatsApp Business webhook (Meta). Required for /api/webhooks/whatsapp to
# work securely — without these the endpoint refuses verification and logs
# a warning that signature checking is disabled.
WHATSAPP_VERIFY_TOKEN="choose-a-long-random-string"
WHATSAPP_APP_SECRET="your-meta-app-secret"
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=


